# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nrt_finance
DB_USER=nrt_user
DB_PASSWORD=your_db_password_here
DB_SSL=false           # set to true in production (Neon, RDS, Supabase etc.)

# ── JWT ───────────────────────────────────────────────────────────
# Generate strong random secrets — minimum 32 characters each:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_hex_secret
JWT_EXPIRES_IN=15m
REFRESH_SECRET=replace_with_different_64_char_hex_secret
REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes in ms
RATE_LIMIT_MAX=300              # max requests per window per IP
AUTH_RATE_LIMIT_MAX=20          # stricter limit on /api/auth/login
